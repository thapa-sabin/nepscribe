<div class="relative overflow-hidden rounded-2xl bg-white shadow-xl ring-1 ring-slate-900/5 sm:px-10 sm:py-12 md:px-12 lg:px-16">
  <div class="relative mx-auto max-w-2xl text-center">
    <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-blue-50">
       <svg class="h-8 w-8 text-blue-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 18.75a6 6 0 006-6v-1.5m-6 7.5a6 6 0 01-6-6v-1.5m6 7.5v3.75m-3.75 0h7.5M12 15.75a3 3 0 01-3-3V4.5a3 3 0 116 0v8.25a3 3 0 01-3 3z" />
      </svg>
    </div>
    
    <h2 class="mt-6 text-3xl font-bold tracking-tight text-slate-900">Record Patient Conversation</h2>
    <p class="mt-4 text-lg text-slate-600">
      Upload an audio recording of your patient session. Our AI will transcribe the conversation and automatically generate structured SOAP notes.
    </p>

    <div class="mt-10">
      <%= form_with model: @recording, local: true, class: "group" do |f| %>
        <div class="relative flex min-h-[200px] w-full cursor-pointer flex-col items-center justify-center rounded-xl border-2 border-dashed border-slate-300 bg-slate-50 px-6 py-10 text-center transition hover:border-blue-500 hover:bg-blue-50/50">
          
          <div class="transition group-hover:scale-110 group-hover:text-blue-600">
            <svg class="mx-auto h-12 w-12 text-slate-400" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M1.5 6a2.25 2.25 0 012.25-2.25h16.5A2.25 2.25 0 0122.5 6v12a2.25 2.25 0 01-2.25 2.25H3.75A2.25 2.25 0 011.5 18V6zM3 16.06V18c0 .414.336.75.75.75h16.5A.75.75 0 0021 18v-1.94l-2.69-2.689a1.5 1.5 0 00-2.12 0l-.88.879.97.97a.75.75 0 11-1.06 1.06l-5.16-5.159a1.5 1.5 0 00-2.12 0L3 16.061zm10.125-7.81a1.125 1.125 0 112.25 0 1.125 1.125 0 01-2.25 0z" clip-rule="evenodd" />
            </svg>
          </div>

          <div class="mt-4 flex flex-col items-center text-sm leading-6 text-slate-600">
             <label for="recording_audio" class="relative cursor-pointer rounded-md bg-transparent font-semibold text-blue-600 focus-within:outline-none focus-within:ring-2 focus-within:ring-blue-600 focus-within:ring-offset-2 hover:text-blue-500">
              <span>Select a file</span>
              <%= f.file_field :audio, class: "sr-only" %>
            </label>
            <p class="pl-1">or drag and drop</p>
            <p class="text-xs text-slate-500 mt-2">MP3, WAV, M4A up to 50MB</p>
          </div>
        </div>

        <div class="mt-8 flex justify-center">
          <%= f.submit "Transcribe with Whisper AI",
              class: "inline-flex items-center gap-2 rounded-xl bg-blue-600 px-8 py-3.5 text-sm font-semibold text-white shadow-sm hover:bg-blue-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 transition-all duration-200" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
