<div class="overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-slate-900/5">
  <div class="border-b border-slate-200 bg-slate-50 px-6 py-4 flex items-center justify-between">
    <div class="flex items-center gap-3">
      <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-white ring-1 ring-slate-200">
        <svg class="h-5 w-5 text-slate-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
        </svg>
      </div>
      <div>
        <h2 class="text-base font-semibold leading-6 text-slate-900">Recording Transcript</h2>
        <p class="text-xs text-slate-500">ID: #<%= @recording.id %></p>
      </div>
    </div>
    
    <div class="flex items-center gap-2">
       <span class="inline-flex items-center rounded-full bg-blue-50 px-2 py-1 text-xs font-medium text-blue-700 ring-1 ring-inset ring-blue-700/10">
        <%= (@recording.status || "Unknown").capitalize %>
      </span>
    </div>
  </div>

  <div class="px-6 py-6">
    <div id="progress-container" class="mb-8">
      <% if @recording.status == "processing" || @recording.status == "pending" %>
        <div class="rounded-xl bg-blue-50 p-4 border border-blue-100">
          <div class="flex items-center gap-3">
             <div class="animate-spin rounded-full h-4 w-4 border-b-2 border-blue-600"></div>
             <p class="text-sm font-medium text-blue-700">AI Transcription in progress...</p>
          </div>
          <div class="mt-3 w-full bg-blue-200 rounded-full h-2 overflow-hidden">
            <div id="progress-bar" class="bg-blue-600 h-2 rounded-full transition-all duration-500 ease-out" style="width: 0%"></div>
          </div>
          <p class="mt-2 text-xs text-blue-500">This usually takes 30-60 seconds depending on audio length.</p>
        </div>
      <% end %>
    </div>

    <div id="transcript-container">
      <% if @recording.transcript&.diarized_content.present? %>
        <div class="space-y-6">
          <h3 class="text-sm font-medium text-slate-500 uppercase tracking-wider">Diarized Conversation</h3>
          <div class="rounded-xl border border-slate-200 bg-slate-50 p-6 shadow-inner">
            <%= render_chat_transcript(@recording.transcript.diarized_content) %>
          </div>
        </div>

      <% elsif @recording.transcript&.content.present? %>
        <div class="space-y-6">
           <h3 class="text-sm font-medium text-slate-500 uppercase tracking-wider">Raw Transcript</h3>
           <div class="rounded-xl border border-slate-200 bg-slate-50 p-6 font-mono text-sm leading-relaxed text-slate-700 whitespace-pre-wrap shadow-inner">
            <%= render_chat_transcript(@recording.transcript.content) %>
          </div>
        </div>

      <% elsif @recording.status == "failed" %>
        <div class="rounded-xl bg-red-50 p-4 border border-red-100 flex items-center gap-3">
           <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd" />
          </svg>
           <p class="text-sm font-medium text-red-700">Transcription failed. Please try uploading the audio again.</p>
        </div>

      <% else %>
        <div class="text-center py-12">
          <svg class="mx-auto h-12 w-12 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z" />
          </svg>
          <h3 class="mt-2 text-sm font-semibold text-slate-900">No transcript available</h3>
          <p class="mt-1 text-sm text-slate-500">The audio is being processed or hasn't been uploaded yet.</p>
        </div>
      <% end %>
    </div>
  </div>
</div>

<% if @recording.status == "processing" || @recording.status == "pending" %>
  <script>
    const progressBar = document.getElementById("progress-bar");

    async function pollStatus() {
      try {
        const res = await fetch("<%= recording_path(@recording, format: :json) %>");
        if (res.ok) {
           const data = await res.json();

          if (data.status === "completed" || data.status === "failed") {
            location.reload();
          } else {
            const currentWidth = parseFloat(progressBar.style.width);
            if (currentWidth < 90) {
                 progressBar.style.width = (currentWidth + (Math.random() * 10)) + "%";
            }
            setTimeout(pollStatus, 3000);
          }
        } else {
           setTimeout(pollStatus, 5000);
        }
      } catch (e) {
          setTimeout(pollStatus, 5000);
      }
    }

    setTimeout(pollStatus, 2000);
  </script>
<% end %>

