<!DOCTYPE html>
<html class="h-full bg-slate-50 antialiased">
  <head>
    <title><%= content_for(:title) || "Nepscribe - Clinical Documentation AI" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
      body { font-family: 'Inter', sans-serif; }
    </style>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="flex min-h-full flex-col">
    
    <!-- Navbar -->
    <header class="sticky top-0 z-50 w-full border-b border-slate-200 bg-white/80 backdrop-blur-md supports-[backdrop-filter]:bg-white/60">
      <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
        
        <!-- Left: Logo -->
        <div class="flex items-center gap-3">
          <div class="flex items-center justify-center w-9 h-9 rounded-lg bg-blue-600 shadow-sm shadow-blue-600/20 text-white">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 18.75a6 6 0 006-6v-1.5m-6 7.5a6 6 0 01-6-6v-1.5m6 7.5v3.75m-3.75 0h7.5M12 15.75a3 3 0 01-3-3V4.5a3 3 0 116 0v8.25a3 3 0 01-3 3z" />
            </svg>
          </div>
          <a href="/" class="group">
            <h1 class="text-lg font-bold tracking-tight text-slate-900 leading-none group-hover:text-blue-600 transition">
              Nepscribe
            </h1>
            <p class="text-[10px] font-semibold text-slate-500 uppercase tracking-wider">Clinical AI</p>
          </a>
        </div>

        <!-- Center: Step Indicator (Progress) -->
        <div class="hidden md:flex absolute left-1/2 transform -translate-x-1/2">
          <%= render "shared/step_indicator" %>
        </div>

        <!-- Right: Actions & Profile -->
        <div class="flex items-center gap-4">
          
          <!-- New Session Button (Desktop) -->
          <%= link_to new_recording_path, class: "hidden sm:inline-flex items-center gap-x-1.5 rounded-full bg-slate-900 px-3.5 py-1.5 text-xs font-semibold text-white shadow-sm hover:bg-slate-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900 transition-all" do %>
            <svg class="-ml-0.5 h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path d="M10.75 4.75a.75.75 0 00-1.5 0v4.5h-4.5a.75.75 0 000 1.5h4.5v4.5a.75.75 0 001.5 0v-4.5h4.5a.75.75 0 000-1.5h-4.5v-4.5z" />
            </svg>
            New Session
          <% end %>

          <div class="h-6 w-px bg-slate-200 hidden sm:block"></div>

          <!-- Profile Dropdown -->
          <button type="button" class="group flex items-center gap-2 focus:outline-none">
            <div class="h-8 w-8 overflow-hidden rounded-full bg-slate-100 ring-2 ring-white ring-offset-1 ring-offset-slate-50 transition group-hover:ring-blue-100">
               <img src="https://ui-avatars.com/api/?name=Dr+Smith&background=0D8ABC&color=fff" alt="User Avatar" class="h-full w-full object-cover">
            </div>
          </button>
        </div>

      </div>
    </header>

    <main class="flex-1 py-10">
      <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
        <!-- Main Content Area -->
        <div class="space-y-6">
            <%= render "shared/flash" %>
            <%= yield %>
        </div>
      </div>
    </main>

    <footer class="mt-auto border-t border-slate-200 bg-white py-8">
      <div class="mx-auto max-w-7xl px-4 text-center text-sm text-slate-500 sm:px-6 lg:px-8">
        &copy; <%= Time.now.year %> Nepscribe. All rights reserved.
      </div>
    </footer>

  </body>
</html>
