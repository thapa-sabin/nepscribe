<div class="space-y-6">
  <!-- Header Card -->
  <div class="overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-slate-900/5">
    <div class="border-b border-slate-200 bg-slate-50 px-6 py-4 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-emerald-600 shadow-md shadow-emerald-600/20 text-white">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
          </svg>
        </div>
        <div>
          <h2 class="text-base font-semibold leading-6 text-slate-900">SOAP Document</h2>
          <p class="text-xs text-slate-500">Generated on <%= @recording.updated_at.strftime("%b %d, %Y at %I:%M %p") %></p>
        </div>
      </div>
      
      <div class="flex items-center gap-2">
        <%= link_to new_recording_path, class: "group inline-flex items-center gap-x-1.5 rounded-full bg-slate-100 px-3 py-1.5 text-xs font-medium text-slate-600 transition hover:bg-slate-200 hover:text-slate-800" do %>
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
             <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
          </svg>
           New Session
        <% end %>
      </div>
    </div>

    <!-- Content -->
    <div class="bg-white p-6 sm:p-8">
      <% if @recording.soap_note.present? %>
        <div class="grid grid-cols-1 gap-8">
          
          <!-- Subjective -->
          <div class="relative pl-6 border-l-4 border-blue-500">
            <h3 class="text-lg font-bold text-slate-900 mb-2 flex items-center gap-2">
              <span class="text-blue-500">S</span>ubjective
            </h3>
            <div class="prose prose-sm prose-slate max-w-none text-slate-600 leading-relaxed">
              <%= simple_format(@recording.soap_note.subjective) %>
            </div>
          </div>

          <!-- Objective -->
          <div class="relative pl-6 border-l-4 border-indigo-500">
             <h3 class="text-lg font-bold text-slate-900 mb-2 flex items-center gap-2">
              <span class="text-indigo-500">O</span>bjective
            </h3>
            <div class="prose prose-sm prose-slate max-w-none text-slate-600 leading-relaxed">
              <%= simple_format(@recording.soap_note.objective) %>
            </div>
          </div>

          <!-- Assessment -->
          <div class="relative pl-6 border-l-4 border-amber-500">
             <h3 class="text-lg font-bold text-slate-900 mb-2 flex items-center gap-2">
              <span class="text-amber-500">A</span>ssessment
            </h3>
            <div class="prose prose-sm prose-slate max-w-none text-slate-600 leading-relaxed">
              <%= simple_format(@recording.soap_note.assessment) %>
            </div>
          </div>

          <!-- Plan -->
          <div class="relative pl-6 border-l-4 border-emerald-500">
             <h3 class="text-lg font-bold text-slate-900 mb-2 flex items-center gap-2">
              <span class="text-emerald-500">P</span>lan
            </h3>
            <div class="prose prose-sm prose-slate max-w-none text-slate-600 leading-relaxed">
              <%= simple_format(@recording.soap_note.plan) %>
            </div>
          </div>

        </div>
      <% else %>
         <div class="text-center py-12">
          <svg class="mx-auto h-12 w-12 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
          </svg>
          <h3 class="mt-2 text-sm font-semibold text-slate-900">No SOAP note available</h3>
          <p class="mt-1 text-sm text-slate-500">Please record and transcribe a session layout to generate notes.</p>
        </div>
      <% end %>
    </div>
  </div>
</div>

